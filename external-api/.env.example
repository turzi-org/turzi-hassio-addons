# ---- HTTP ----
PORT=8080
LOG_REQUESTS=true

# ---- Site ----
# A label recorded on every log row, identifying this building.
TURZI_HOUSE_ID=

# ---- Home Assistant (standalone only) ----
# As an add-on both come from the Supervisor and neither is set here.
HA_URL=http://homeassistant.local:8123
# A long-lived access token: HA profile page -> Security -> Long-lived tokens.
HA_TOKEN=
# Overrides the URL derived from HA_URL, if your setup needs it.
# HA_WS_URL=ws://homeassistant.local:8123/api/websocket

# ---- Database (standalone only) ----
# As a Home Assistant add-on none of this applies: credentials come from the
# Supervisor's MariaDB service. For docker-compose, these two are enough —
# DATABASE_URL is assembled for you and points at the bundled MariaDB.
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# Set this instead when pointing at a database you manage yourself.
# DATABASE_URL=mysql://user:password@host:3306/turzi_external_api
DATABASE_POOL_MAX=5
# Home Assistant does not order add-on startup, so boot retries this long
# before giving up on the database.
DATABASE_CONNECT_TIMEOUT_MS=60000

# ---- Callers ----
# label:secret pairs, comma separated. The label is stamped on every command
# and appears both in the action log and in the Home Assistant logbook, so
# name it after the system that will be calling.
API_KEYS=acme-access-control:CHANGE_ME_LONG_RANDOM_STRING

# Optional. Used only when ALLOWED_ENTITIES is empty. Defaults to the same set
# the v2 API relays.
# ALLOWED_DOMAINS=lock,cover,alarm_control_panel,light,switch,climate,fan,media_player,vacuum,humidifier,scene,script,button,input_boolean

# The security boundary, and what gets logged: full entity ids. Empty falls
# back to ALLOWED_DOMAINS, i.e. everything in those domains.
# ALLOWED_ENTITIES=cover.garage,lock.front_door

# Optional. Domain used to build the actor's email from the key label.
ACTOR_EMAIL_DOMAIN=external-api.turzi.local

# ---- Timing ----
# How long a command waits for the resulting state change. Normally it
# resolves in single-digit milliseconds; this is only a backstop.
COMMAND_CONFIRM_TIMEOUT_MS=4000
