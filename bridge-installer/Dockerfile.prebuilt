# The installer as CI builds it (.github/workflows/bridge-installer-image.yml),
# for the Supervisor to pull instead of building: the same add-on, with the
# bridge and the integrations in integrations.lock fetched by CI with a read
# token, so their repositories can be private (turzi-apps PRIVATE_IMAGES.md
# §7.3). `integrations` is that checkout: one folder per integration.
FROM alpine:3.22

ARG BRIDGE_VERSION
COPY --from=integrations . /opt/turzi/
RUN test -n "${BRIDGE_VERSION}" \
 && grep -q "\"version\": \"${BRIDGE_VERSION}\"" /opt/turzi/turzi_bridge/manifest.json \
 && rm -rf /opt/turzi/*/__pycache__

COPY run.sh /run.sh
RUN chmod +x /run.sh
CMD ["/run.sh"]
