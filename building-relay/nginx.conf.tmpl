# Turzi building relay (DEVICE_PROVIDERS.md §3.3 local media path).
# The same signed-URL contract AND the same host-derived routing as
# the cloud relay, running inside the building: one relay fronts every
# video server (N Frigate/go2rtc instances) — the request hostname
# encodes the target box (10-0-1-25.local.… → upstream 10.0.1.25,
# validated to private/CGNAT ranges), DNS points those names at this
# relay, and media never leaves the LAN.
#
# Rendered by the entrypoint — only ${CERT_DIR}, ${FRIGATE_PORT} and
# ${GO2RTC_PORT} are substituted; the signing secret reaches Lua via
# the environment (or the provisioned secret file), never this file.

worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;
env STREAM_SECRET;
env STREAM_SECRET_FILE;

events {
    worker_connections 1024;
}

http {
    access_log /dev/stdout;

    init_by_lua_block {
        -- Auto-provisioned relays read the secret from /data (re-read on
        -- HUP, so daily refreshes can rotate it); manual mode uses env.
        local secret_file = os.getenv("STREAM_SECRET_FILE")
        if secret_file then
            local fh = io.open(secret_file, "r")
            if fh then relay_secret = fh:read("*l"); fh:close() end
        else
            relay_secret = os.getenv("STREAM_SECRET")
        end

        -- Signature contract (must match api-v2 stream-access.service):
        --   sig = base64url( hmac_sha1( secret, "{exp}:{path}" ) )
        function relay_check()
            if not relay_secret or relay_secret == "" then
                ngx.log(ngx.ERR, "STREAM_SECRET not configured")
                return ngx.exit(500)
            end
            local args = ngx.req.get_uri_args()
            local exp = tonumber(args.exp)
            local sig = args.sig
            if not exp or type(sig) ~= "string" then return ngx.exit(410) end
            if exp < ngx.time() then return ngx.exit(410) end
            local digest = ngx.encode_base64(ngx.hmac_sha1(relay_secret, exp .. ":" .. ngx.var.uri))
            local expected = digest:gsub("%+", "-"):gsub("/", "_"):gsub("=+$", "")
            if expected ~= sig then return ngx.exit(403) end
        end

        -- Host header → upstream IP: the hostname IS the routing table.
        -- Only LAN-reachable ranges (RFC1918 + 100.64/10) pass.
        function relay_route()
            local v = ngx.var
            local o = { tonumber(v.h1), tonumber(v.h2), tonumber(v.h3), tonumber(v.h4) }
            for _, x in ipairs(o) do
                if not x or x > 255 then return ngx.exit(421) end
            end
            local ok = o[1] == 10
                or (o[1] == 172 and o[2] >= 16 and o[2] <= 31)
                or (o[1] == 192 and o[2] == 168)
                or (o[1] == 100 and o[2] >= 64 and o[2] <= 127)
            if not ok then return ngx.exit(421) end
            ngx.var.up = o[1] .. "." .. o[2] .. "." .. o[3] .. "." .. o[4]
            relay_check()
        end
    }

    server {
        listen 443 ssl;
        # \d+ (not {1,3}): braces break unquoted nginx regexes; Lua
        # validates the octet ranges anyway.
        server_name ~^(?<h1>\d+)-(?<h2>\d+)-(?<h3>\d+)-(?<h4>\d+)\.;
        ssl_certificate     ${CERT_DIR}/fullchain.pem;
        ssl_certificate_key ${CERT_DIR}/privkey.pem;

        set $up "";

        # Snapshot tier: Frigate's latest frame, polled ~1/s by clients.
        location ~ "^/cam/(?<cam>[^/]+)/latest\.jpg$" {
            access_by_lua_block { relay_route() }
            proxy_pass http://$up:${FRIGATE_PORT}/api/$cam/latest.jpg;
        }

        # Snapshot tier, go2rtc frame grab (cameras Frigate doesn't snapshot).
        location ~ "^/cam/(?<cam>[^/]+)/frame\.jpg$" {
            access_by_lua_block { relay_route() }
            proxy_pass http://$up:${GO2RTC_PORT}/api/frame.jpeg?src=$cam;
        }

        # Live tier, progressive MP4 (the app's transport).
        location ~ "^/cam/(?<cam>[^/]+)/stream\.mp4$" {
            access_by_lua_block { relay_route() }
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_pass http://$up:${GO2RTC_PORT}/api/stream.mp4?src=$cam&video=h264&audio=aac;
        }

        # Live tier, MSE over WebSocket (the TCM's transport).
        location ~ "^/cam/(?<cam>[^/]+)/mse$" {
            access_by_lua_block { relay_route() }
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_pass http://$up:${GO2RTC_PORT}/api/ws?src=$cam;
        }

        # Stream inventory for go2rtc discovery (signed like media paths).
        location = /streams {
            access_by_lua_block { relay_route() }
            proxy_pass http://$up:${GO2RTC_PORT}/api/streams;
        }

        # Unauthenticated liveness probe.
        location = /healthz {
            return 200 "ok\n";
        }

        location / {
            return 404;
        }
    }
}
